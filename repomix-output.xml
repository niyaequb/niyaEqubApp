              fontWeight: FontWeight.w600,
              textColor: badgeColor,
            ),
          ),
          IconButton(
            onPressed: onRemove,
            visualDensity: VisualDensity.compact,
            icon: Icon(Icons.close_rounded, size: 16.r, color: appColors.hintTextColor),
          ),
        ],
      ),
    );
  }
}

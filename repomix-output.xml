        final companyFacts = switch (state) {
          EkubHomeSuccess s => s.promotions?.companyFacts ?? const [],
          _ => const <CompanyFact>[],
        };

        final appColors = colors(context);
        final isDark = Theme.of(context).brightness == Brightness.dark;

                                    context,
                                    user: user,
                                    headers: headers,
                                    profileBloc: context
                                        .read<EkubProfileBloc>(),
                                    imagePicker: _imagePicker,
                                  ),
                          ),
                          SizedBox(width: 12.w),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [

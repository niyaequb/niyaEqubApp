                                fontWeight: FontWeight.w600,
                                textColor: appColors.titleTextColor,
                              ),
                              CustomText(
                                title: item.url,
                                fontSize: 11.sp,
                                fontWeight: FontWeight.w400,
                                textColor: appColors.bodyTextSmallColor,
                              ),
                            ],

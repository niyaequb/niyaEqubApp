<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Niya Umrah Equb</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Allow Niya Umrah Equb to access your photos to set a profile picture.</string>
		<key>NSCameraUsageDescription</key>
		<string>Allow Niya Umrah Equb to use the camera to take a profile picture.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Allow Niya Umrah Equb to save photos to your library.</string>
		<!-- Ibada Center: prayer times and the Qibla compass. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Niya Umrah Equb uses your location to calculate accurate prayer times and the direction of the Qibla.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Niya Umrah Equb uses your location to calculate accurate prayer times and the direction of the Qibla.</string>
		<key>NSMotionUsageDescription</key>
		<string>Niya Umrah Equb uses the compass sensors to point you towards the Qibla.</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Niya Umrah Equb</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- Portrait only. Matches android:screenOrientation="portrait" on
	     MainActivity and the SystemChrome lock in main.dart. iOS reads this
	     list before the engine starts, so leaving landscape in here lets the
	     launch screen rotate even though Flutter later refuses to. -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- Lets Quran recitation keep playing when the screen locks, and lets FCM
	     deliver prayer announcements while backgrounded. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
